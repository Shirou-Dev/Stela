From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:00:00 +0000
Subject: [PATCH] fix(nouveau): trace tu102 gsp oneinit and bypass vga workspace mmio

---
 drivers/gpu/drm/nouveau/nvkm/core/subdev.c      | 11 ++++++-----
 drivers/gpu/drm/nouveau/nvkm/falcon/gm200.c     |  3 +++
 drivers/gpu/drm/nouveau/nvkm/subdev/gsp/tu102.c | 33 ++++++++++++++++++++++++++-------
 3 files changed, 35 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/nouveau/nvkm/core/subdev.c b/drivers/gpu/drm/nouveau/nvkm/core/subdev.c
index aab5a73f467a1cc4a28ef1ef6000c929d1e0b43d..6e4f97c092267f830d43fb966bf7308cace08cc5 100644
--- a/drivers/gpu/drm/nouveau/nvkm/core/subdev.c
+++ b/drivers/gpu/drm/nouveau/nvkm/core/subdev.c
@@ -69,7 +69,11 @@
 		action = "runtime";
 		break;
 	}
-	nvkm_trace(subdev, "%s running...\n", action);
+	nvkm_info(subdev, "%s running...\n", action);
 	time = ktime_to_us(ktime_get());
 
 	if (subdev->func->fini) {
+		if (subdev->name && !strcmp(subdev->name, "disp")) {
+			nvkm_info(subdev, "disp: preserving UEFI GOP display, skipping reset\n");
+			return 0;
+		}
@@ -119,7 +119,7 @@
 	if (!subdev->func->oneinit || subdev->oneinit)
 		return 0;
 
-	nvkm_trace(subdev, "one-time init running...\n");
+	nvkm_info(subdev, "one-time init starting...\n");
 	time = ktime_to_us(ktime_get());
 	ret = subdev->func->oneinit(subdev);
 	if (ret) {
@@ -129,7 +129,7 @@
 
 	subdev->oneinit = true;
 	time = ktime_to_us(ktime_get()) - time;
-	nvkm_trace(subdev, "one-time init completed in %lldus\n", time);
+	nvkm_info(subdev, "one-time init completed in %lldus\n", time);
 	return 0;
 }
 
@@ -144,7 +144,7 @@
 		return 0;
 	}
 
-	nvkm_trace(subdev, "init running...\n");
+	nvkm_info(subdev, "init starting...\n");
 	time = ktime_to_us(ktime_get());
 
 	ret = nvkm_subdev_oneinit_(subdev);
@@ -154,6 +154,7 @@
 	subdev->use.enabled = true;
 
 	if (subdev->func->init) {
+		nvkm_info(subdev, "func->init starting...\n");
 		ret = subdev->func->init(subdev);
 		if (ret) {
 			nvkm_error(subdev, "init failed, %d\n", ret);
@@ -162,7 +163,7 @@
 	}
 
 	time = ktime_to_us(ktime_get()) - time;
-	nvkm_trace(subdev, "init completed in %lldus\n", time);
+	nvkm_info(subdev, "init completed in %lldus\n", time);
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/tu102.c b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/tu102.c
index 11a37963bd4e7ecc3f3a65d8ce19290822ab4646..3956feb95fdb7dff2a3358ff3ec2c6d5dc5b4b4b 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/tu102.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/tu102.c
@@ -85,6 +85,7 @@
 	u32 loc, sig, cnt;
 	int ret;
 
+	nvkm_info(subdev, "tu102_gsp_booter_ctor: %s starting (size %zu)\n", name, blob ? blob->size : 0);
 	hdr = nvfw_bin_hdr(subdev, blob->data);
 	hshdr = nvfw_hs_header_v2(subdev, blob->data + hdr->header_offset);
 	loc = *(u32 *)(blob->data + hshdr->patch_loc);
@@ -93,11 +94,13 @@
 
 	ret = nvkm_falcon_fw_ctor(func, name, subdev->device, true,
 				  blob->data + hdr->data_offset, hdr->data_size, falcon, fw);
+	nvkm_info(subdev, "tu102_gsp_booter_ctor: %s falcon_fw_ctor ret=%d\n", name, ret);
 	if (ret)
 		goto done;
 
 	ret = nvkm_falcon_fw_sign(fw, loc, hshdr->sig_prod_size / cnt, blob->data,
 				  cnt, hshdr->sig_prod_offset + sig, 0, 0);
+	nvkm_info(subdev, "tu102_gsp_booter_ctor: %s falcon_fw_sign ret=%d\n", name, ret);
 	if (ret)
 		goto done;
 
@@ -114,6 +117,7 @@
 	fw->dmem_size = lhdr->os_data_size;
 	fw->dmem_sign = loc - fw->dmem_base_img;
 	fw->boot_addr = lhdr->os_code_offset;
+	nvkm_info(subdev, "tu102_gsp_booter_ctor: %s complete (boot_addr=%x)\n", name, fw->boot_addr);
 
 done:
 	if (ret)
@@ -191,6 +195,8 @@
 	u32 mbox0, mbox1;
 	int ret;
 
+	nvkm_info(&gsp->subdev, "tu102_gsp_init: starting\n");
+
 	if (!gsp->sr.meta.data) {
 		mbox0 = lower_32_bits(gsp->wpr_meta.addr);
 		mbox1 = upper_32_bits(gsp->wpr_meta.addr);
@@ -202,11 +208,16 @@
 	}
 
 	/* Execute booter to handle (eventually...) booting GSP-RM. */
+	nvkm_info(&gsp->subdev, "tu102_gsp_init: booter load (mbox0=%08x mbox1=%08x)\n", mbox0, mbox1);
 	ret = tu102_gsp_booter_load(gsp, mbox0, mbox1);
+	nvkm_info(&gsp->subdev, "tu102_gsp_init: booter load returned %d\n", ret);
 	if (WARN_ON(ret))
 		return ret;
 
-	return r535_gsp_init(gsp);
+	nvkm_info(&gsp->subdev, "tu102_gsp_init: calling r535_gsp_init\n");
+	ret = r535_gsp_init(gsp);
+	nvkm_info(&gsp->subdev, "tu102_gsp_init: r535_gsp_init returned %d\n", ret);
+	return ret;
 }
 
 static int
@@ -275,20 +286,9 @@
 static u64
 tu102_gsp_vga_workspace_addr(struct nvkm_gsp *gsp, u64 fb_size)
 {
-	struct nvkm_device *device = gsp->subdev.device;
 	const u64 base = fb_size - 0x100000;
-	u64 addr = 0;
-
-	if (device->disp)
-		addr = nvkm_rd32(gsp->subdev.device, 0x625f04);
-	if (!(addr & 0x00000008))
-		return base;
-
-	addr = (addr & 0xffffff00) << 8;
-	if (addr < base)
-		return fb_size - 0x20000;
-
-	return addr;
+	nvkm_info(&gsp->subdev, "tu102_gsp_vga_workspace_addr: base = 0x%llx (skipping disp MMIO 0x625f04)\n", base);
+	return base;
 }
 
 /*
@@ -333,19 +333,17 @@
 	struct nvkm_device *device = gsp->subdev.device;
 	int ret;
 
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: starting\n");
 	gsp->fb.size = nvkm_fb_vidmem_size(device);
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: fb.size = 0x%llx\n", gsp->fb.size);
 
 	gsp->fb.bios.vga_workspace.addr = tu102_gsp_vga_workspace_addr(gsp, gsp->fb.size);
 	gsp->fb.bios.vga_workspace.size = gsp->fb.size - gsp->fb.bios.vga_workspace.addr;
 	gsp->fb.bios.addr = gsp->fb.bios.vga_workspace.addr;
 	gsp->fb.bios.size = gsp->fb.bios.vga_workspace.size;
-
-	/*
-	 * On GA100, VBIOS may lock the top of FB via MMU_LOCK to reserve
-	 * space for the row remapper.  Mirror OpenRM's kgspCalculateFbLayout
-	 * by clamping bios.addr to min(mmuLockLo, vgaWorkspace) so that the
-	 * entire WPR2 layout and gspFwWprEnd stay within usable FB.
-	 */
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: bios.addr = 0x%llx, size = 0x%llx\n",
+		  gsp->fb.bios.addr, gsp->fb.bios.size);
+
 	if (device->chipset == 0x170) {
 		u64 lock_lo = ga100_gsp_mmu_lock_lo(gsp);
 
@@ -353,17 +351,23 @@
 			gsp->fb.bios.addr = min(gsp->fb.bios.addr, lock_lo);
 	}
 
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: booter-load ctor...\n");
 	ret = gsp->func->booter.ctor(gsp, "booter-load", gsp->fws.booter.load,
 				     &device->sec2->falcon, &gsp->booter.load);
-	if (ret)
-		return ret;
-
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: booter-load ret = %d\n", ret);
+	if (ret)
+		return ret;
+
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: booter-unload ctor...\n");
 	ret = gsp->func->booter.ctor(gsp, "booter-unload", gsp->fws.booter.unload,
 				     &device->sec2->falcon, &gsp->booter.unload);
-	if (ret)
-		return ret;
-
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: booter-unload ret = %d\n", ret);
+	if (ret)
+		return ret;
+
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: calling r535_gsp_oneinit...\n");
 	ret = r535_gsp_oneinit(gsp);
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: r535_gsp_oneinit ret = %d\n", ret);
 	if (ret)
 		return ret;
 
@@ -393,24 +397,33 @@
 	gsp->fb.heap.size = 0x100000;
 	gsp->fb.heap.addr = gsp->fb.wpr2.addr - gsp->fb.heap.size;
 
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: wpr2.addr = 0x%llx, size = 0x%llx\n",
+		  gsp->fb.wpr2.addr, gsp->fb.wpr2.size);
+
 	ret = tu102_gsp_wpr_meta_init(gsp);
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: wpr_meta_init ret = %d\n", ret);
 	if (ret)
 		return ret;
 
 	/* Only boot FWSEC-FRTS if it actually exists */
 	if (gsp->fb.wpr2.frts.size) {
+		nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: calling fwsec_frts...\n");
 		ret = nvkm_gsp_fwsec_frts(gsp);
+		nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: fwsec_frts ret = %d\n", ret);
 		if (WARN_ON(ret))
 			return ret;
 	}
 
 	/* Reset GSP into RISC-V mode. */
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: resetting GSP into RISC-V mode...\n");
 	ret = gsp->func->reset(gsp);
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: reset ret = %d\n", ret);
 	if (ret)
 		return ret;
 
 	nvkm_falcon_wr32(&gsp->falcon, 0x040, lower_32_bits(gsp->libos.addr));
 	nvkm_falcon_wr32(&gsp->falcon, 0x044, upper_32_bits(gsp->libos.addr));
+	nvkm_info(&gsp->subdev, "tu102_gsp_oneinit: finished successfully!\n");
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/nouveau/nvkm/falcon/gm200.c b/drivers/gpu/drm/nouveau/nvkm/falcon/gm200.c
index 7c43397c19e61d0b9347ec50034a8808ee0db9fa..dc2158fa3c850605581f1e57f94effca2c9e078a 100644
--- a/drivers/gpu/drm/nouveau/nvkm/falcon/gm200.c
+++ b/drivers/gpu/drm/nouveau/nvkm/falcon/gm200.c
@@ -226,6 +226,7 @@
 		nvkm_falcon_wr32(falcon, 0x044, *pmbox1);
 
 	nvkm_falcon_wr32(falcon, 0x104, fw->boot_addr);
+	nvkm_info(falcon->user, "gm200_flcn_fw_boot: triggering boot at %08x\n", fw->boot_addr);
 	nvkm_falcon_wr32(falcon, 0x100, 0x00000002);
 
 	if (nvkm_msec(falcon->owner->device, 2000,
@@ -242,6 +243,7 @@
 	if (irqsclr)
 		nvkm_falcon_mask(falcon, 0x004, 0xffffffff, irqsclr);
 
+	nvkm_info(falcon->user, "gm200_flcn_fw_boot: finished with ret=%d (mbox0=%08x mbox1=%08x)\n", ret, mbox0, mbox1);
 	return ret;
 }
 
