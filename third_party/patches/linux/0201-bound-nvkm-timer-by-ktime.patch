From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:25:00 +0000
Subject: [PATCH] fix(nouveau): bound nvkm_nsec waits by kernel time to prevent
 infinite loops when GPU timer halts

---
 .../gpu/drm/nouveau/include/nvkm/subdev/timer.h | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/nouveau/include/nvkm/subdev/timer.h b/drivers/gpu/drm/nouveau/include/nvkm/subdev/timer.h
index 920fbc0516fc29b7754b2d8e48a3a290a359871c..eb6297298642a849d10e53a3390f0559fba08821 100644
--- a/drivers/gpu/drm/nouveau/include/nvkm/subdev/timer.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/subdev/timer.h
@@ -2,6 +2,7 @@
 #ifndef __NVKM_TIMER_H__
 #define __NVKM_TIMER_H__
 #include <core/subdev.h>
+#include <linux/ktime.h>
 
 struct nvkm_alarm {
 	struct list_head head;
@@ -52,10 +53,19 @@ s64 nvkm_timer_wait_test(struct nvkm_timer_wait *);
 #define NVKM_DELAY _warn = false;
 #define nvkm_nsec(d,n,cond...) ({                                              \
 	struct nvkm_timer_wait _wait;                                          \
+	ktime_t _kstart = ktime_get();                                         \
 	bool _warn = true;                                                     \
 	s64 _taken = 0;                                                        \
                                                                                \
 	nvkm_timer_wait_init((d), (n), &_wait);                                \
 	do {                                                                   \
 		cond                                                           \
+		if ((n) && ktime_to_ns(ktime_sub(ktime_get(), _kstart)) >= (n)) { \
+			_taken = -ETIMEDOUT;                                   \
+			break;                                                 \
+		}                                                              \
+		cpu_relax();                                                   \
 	} while ((_taken = nvkm_timer_wait_test(&_wait)) >= 0);                \
                                                                                \
 	if (_warn && _taken < 0)                                               \
-		dev_WARN(_wait.tmr->subdev.device->dev, "timeout\n");          \
+		dev_WARN(_wait.tmr ? _wait.tmr->subdev.device->dev : (d)->dev, "timeout\n"); \
 	_taken;                                                                \
 })
